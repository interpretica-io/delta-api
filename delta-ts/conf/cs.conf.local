---
- register:
    - oid: "/local/ta"
      access: "read_create"
      type: "string"
    - oid: "/local/tst_if"
      access: "read_create"
      type: "string"
    - oid: "/local/tst_if_ip"
      access: "read_create"
      type: "string"
    - oid: "/local/tst_if_mac"
      access: "read_create"
      type: "string"
    - oid: "/local/addr"
      access: "read_create"
      type: "none"
    - oid: "/local/addr/entry"
      access: "read_create"
      type: "none"
    - oid: "/local/addr/entry/address"
      access: "read_write"
      type: "address"
    - oid: "/local/addr/entry/hostname"
      access: "read_write"
      type: "string"
    - oid: "/local/addr/entry/prefix"
      access: "read_write"
      type: "integer"

- register:
    - oid: "/local/conf"
      access: "read_write"
      type: "string"
      volatile: "true"
    - oid: "/local/conf/commited"
      access: "read_write"
      type: "integer"
      volatile: "true"

- register:
    - oid: "/local/tmp"
      access: "read_create"
      type: "none"
    - oid: "/local/tmp/perf"
      access: "read_create"
      type: "none"

- add:
    - oid: "/local:/tmp:"
    - oid: "/local:/tmp:/perf:"

- set:
    - oid: "/local:/use_static_arp:"
      value: "0"

- add:
    - oid: "/local:/addr:"

- set:
    - oid: "/local:/rpcserver_force_restart:"
      value: "1"